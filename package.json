{
  "name": "world-seek",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server/index.ts",
    "build": "next build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "horror:catalogue": "tsx scripts/horror-catalogue-snapshot.mjs",
    "horror:catalogue:update": "tsx scripts/horror-catalogue-snapshot.mjs --update",
    "horror:sim": "tsx scripts/horror-sim.mjs",
    "horror:items": "tsx scripts/horror-items-sim.mjs",
    "horror:boss": "tsx scripts/horror-boss-sim.mjs",
    "horror:verify": "tsx scripts/horror-verify.mjs",
    "test:horror": "npm run horror:catalogue && npm run horror:sim && npm run horror:items && npm run horror:boss && npm run horror:verify"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^1.16.8",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-qr-code": "^2.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/google.maps": "^3.58.1",
    "@types/node": "^20.14.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
